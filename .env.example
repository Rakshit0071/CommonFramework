# Gmail credentials (for authentication) - single personal account, no roles
GMAIL_USERNAME=your-email@gmail.com
GMAIL_PASSWORD=your-password

# EEN base/API URLs
EEN_BASE_URL=https://webapp.eagleeyenetworks.com
EEN_API_URL=https://api.eagleeyenetworks.com

# EEN credentials - role-based (see apps/een/src/setup/auth.setup.ts)
EEN_STANDARD_USERNAME=your-standard-user@example.com
EEN_STANDARD_PASSWORD=your-password
EEN_ADMIN_USERNAME=your-admin-user@example.com
EEN_ADMIN_PASSWORD=your-password
EEN_READONLY_USERNAME=your-readonly-user@example.com
EEN_READONLY_PASSWORD=your-password

# Slack notifications (optional - scripts/notify.ts no-ops if unset)
SLACK_WEBHOOK_URL=
